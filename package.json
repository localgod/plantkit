{
  "name": "plantkit",
  "version": "1.1.0",
  "description": "",
  "keywords": [
    "archimate",
    "plantuml",
    "typescript"
  ],
  "homepage": "https://github.com/localgod/plantkit#README",
  "bugs": {
    "url": "https://github.com/localgod/plantkit/issues"
  },
  "license": "MIT",
  "author": "Johannes Skov Frandsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localgod/plantkit.git"
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config",
    "prebuild": "node scripts/generate-index.js",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "check": "vp check",
    "test": "vp test",
    "test:plantuml": "bash scripts/smoke-plantuml.sh",
    "test:coverage": "vp test --coverage",
    "test:neutral": "node scripts/check-runtime-neutral.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "csv": "^6.3.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
