{
  // PlantUML settings
  "plantuml.render": "Local",
  "plantuml.commandArgs": ["-DPLANTUML_LIMIT_SIZE=30000"],
  "plantuml.jar": "./plantuml.jar",
  "plantuml.includepaths": [],
  "plantuml.diagramsRoot": "",
  "plantuml.exportOutDir": "out",
  "plantuml.exportFormat": "png",
  "plantuml.exportSubFolder": false,
  "plantuml.exportIncludeFolderHeirarchy": true,
  "plantuml.jarArgs": ["-DRELATIVE_INCLUDE=."],

  // Editor settings
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": true,

  // File settings
  "files.insertFinalNewline": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  }
}
